# FURNITURE PROCUREMENT

@app.route('/procurement', methods=['GET', 'POST'])
@login_required
def procurement():

    if Flask.request.method == 'POST':

        project_id = int(Flask.request.form['project_id'])
        furniture_id = int(Flask.request.form['furniture_id'])
        supplier_id = int(Flask.request.form['supplier_id'])
        quantity = int(Flask.request.form['quantity'])

        cursor.execute(
            "SELECT price FROM furniture WHERE id=%s",
            (furniture_id,)
        )

        item = cursor.fetchone()

        if not item:
            return "Furniture not found!", 404

        total = item['price'] * quantity

        sql = """INSERT INTO procurement
        (project_id, furniture_id, supplier_id, quantity, total_cost)
        VALUES (%s,%s,%s,%s,%s)"""

        cursor.execute(sql, (
            project_id,
            furniture_id,
            supplier_id,
            quantity,
            total
        ))

        db.commit()

        return f"""
        Procurement Added Successfully!
        <br>Total Cost: ₹{total}
        <br><a href='/'>Home</a>
        """

    return """
    <h2>Furniture Procurement</h2>

    <form method="POST">

        Project ID:
        <input type="number" name="project_id" required><br><br>

        Furniture ID:
        <input type="number" name="furniture_id" required><br><br>

        Supplier ID:
        <input type="number" name="supplier_id" required><br><br>

        Quantity:
        <input type="number" name="quantity" min="1" required><br><br>

        <button type="submit">Purchase Furniture</button>

    </form>
    """


# NUMPY AND PANDAS BUDGET ANALYSIS

@app.route('/analysis')
@login_required
def analysis():

    cursor.execute("""
        SELECT
        p.project_name,
        p.budget,
        COALESCE(SUM(pr.total_cost), 0) AS expenses
        FROM projects p
        LEFT JOIN procurement pr
        ON p.id = pr.project_id
        GROUP BY p.id, p.project_name, p.budget
    """)

    data = cursor.fetchall()

    if not data:
        return "No project data available! <a href='/'>Home</a>"

    df = pd.DataFrame(data)

    expenses = np.array(df['expenses'], dtype=float)

    total_expenses = np.sum(expenses)
    average_expenses = np.mean(expenses)
    maximum_expenses = np.max(expenses)

    df['remaining_budget'] = df['budget'] - df['expenses']

    result = f"""
    <h2>Budget Analysis Report</h2>

    <h3>Total Expenses: ₹{total_expenses:.2f}</h3>

    <h3>Average Expenses: ₹{average_expenses:.2f}</h3>

    <h3>Maximum Expenses: ₹{maximum_expenses:.2f}</h3>

    <h3>Project-wise Analysis</h3>
    """

    for _, row in df.iterrows():

        result += f"""
        <p>
        Project: {row['project_name']}<br>
        Budget: ₹{row['budget']}<br>
        Expenses: ₹{row['expenses']}<br>
        Remaining Budget: ₹{row['remaining_budget']}
        </p>
        <hr>
        """

    return result + "<br><a href='/'>Home</a>"


