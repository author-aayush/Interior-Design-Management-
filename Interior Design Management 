@app.after_request
def add_css(response):

    if response.content_type and "text/html" in response.content_type:
        html = response.get_data(as_text=True)

        if "</head>" in html:
            html = html.replace("</head>", CSS + "</head>", 1)
        else:
            html = CSS + html

        response.set_data(html)

    return response

